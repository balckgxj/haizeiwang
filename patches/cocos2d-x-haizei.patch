diff --git a/cocos/platform/win32/CCCommon-win32.cpp b/cocos/platform/win32/CCCommon-win32.cpp
index c3b97c1..67cac9c 100644
--- a/cocos/platform/win32/CCCommon-win32.cpp
+++ b/cocos/platform/win32/CCCommon-win32.cpp
@@ -37,9 +37,11 @@ NS_CC_BEGIN
 
 void MessageBox(const char * pszMsg, const char * pszTitle)
 {
-    std::wstring wsMsg = cocos2d::StringUtf8ToWideChar(pszMsg);
-    std::wstring wsTitle = cocos2d::StringUtf8ToWideChar(pszTitle);
-    MessageBoxW(nullptr, wsMsg.c_str(), wsTitle.c_str(), MB_OK);
+    // [haizei] 原版是模态 MessageBoxW（阻塞主循环）。本工程把它降级为日志输出：
+    // 游戏代码大量用 CCMessageBox 报“变量缺失/资源缺失”这类非致命错误（2.x 私改版
+    // 同款逻辑），模态框会直接卡死游戏（自动化验证尤其致命）。与 2.x 不同的点在于
+    // 2.x 的数据/流程大多不会触发；移植初期先保证不卡死、错误可见，后续按日志逐个修。
+    CCLOG("[MessageBox] %s: %s", pszTitle ? pszTitle : "", pszMsg ? pszMsg : "");
 }
 
 void LuaLog(const char *pszMsg)
